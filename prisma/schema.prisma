generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id            String    @id @default(cuid())
  name          String
  classification String   @default("new") // new | returning
  city          String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  contacts      Contact[]
  leads         Lead[]
}

model Contact {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fullName  String
  phone     String
  email     String?
  role      String?  // director, secretary, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]

  @@index([phone])
}

model Lead {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Tab 1 – Contact info (denormalized for fast mobile edit)
  fullName   String
  /** שם איש קשר (נפרד משם הארגון / הלקוח ב-fullName) */
  contactName String?
  /** שם איש קשר משני — משויך ל-phoneSecondary */
  contactNameSecondary String?
  phone      String
  /** טלפון משני אופציונלי */
  phoneSecondary String?
  email      String?
  city       String?
  leadSource String?  // website, friends, facebook, returning, other
  urgency    String   @default("normal") // normal | urgent

  // Pipelines
  activityType      String  @default("course") // course | equipment | combined
  courseStatus      String  @default("new")
  // new | cold | pending | closed | certificates_pending | closed_won | canceled
  // legacy: completed (migrated → certificates_pending)
  equipmentStatus   String?
  // inquiry | requisition_received | supplied_invoiced | pending_payment | completed_paid

  // Tab 2 – Course details
  reason               String?
  courseType           String?  // 22_hours | 44_hours | 60_hours | paramedic | other
  courseTypeOther      String?
  courseCategory       String?  // yeshiva_students | shipping_raspan | firearms | other
  courseCategoryOther  String?
  kindergartenApproved Boolean  @default(false)
  expectedParticipants Int?
  sessionsCount        Int?
  sessionDuration      String?  // 2.5_hours | 3_hours | 4_hours | 4+_hours | other
  sessionDurationOther String?
  bookletRequired      Boolean  @default(false)

  /** שדות ייעודיים לרענון עזרה ראשונה+התנהלות בטוחה (מעון/גן) */
  kindergartenManagerName  String?
  kindergartenManagerPhone String?
  institutionSymbol        String?
  basicTrainingDate        String?  // YYYY-MM-DD

  // Schedule (required for closed)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  location       String?
  instructor     String?
  /** מדריך משובץ — מקור האמת לתעריף החי */
  instructorId   String?
  instructorRef  Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  /** דריסת תעריף להדרכה ספציפית; אם null — משתמשים בתעריף החי של המדריך */
  instructorFeeOverride Float?

  // Tab 3 – Pricing & delivery
  pricingModel       String  @default("flat_rate") // flat_rate | per_participant
  perParticipantRate Float?
  /** תוספת למשתתף מעבר ל-25 (ברירת מחדל 50) */
  extraParticipantPrice Float? @default(50)
  agreedPrice        Float?
  quoteStatus        String  @default("not_sent") // sent | not_sent
  quoteSentAt        DateTime?
  paymentTerms       String? // immediate | net_30 | net_60 | other
  paymentStatus      String  @default("pending_official_order")
  // pending_official_order | invoice_issued_pending_net | paid_in_full
  /** תאריך ביצוע התשלום בפועל */
  paymentDate        DateTime?
  /** bit | bank_transfer | cash | paybox | other */
  paymentMethod      String?
  /** יצחק | לינוי */
  paymentReceivedBy  String?
  paymentReceiptIssued Boolean @default(false)
  /** קורס פרטי (לו״ז ורוד) מול קבוצה */
  isPrivateCourse    Boolean @default(false)
  /** מפגשים נוספים כ־JSON (legacy mirror): [{date,time,endTime?,isZoom?,zoomLink?,city?,street?,houseNumber?}] */
  sessionsJson       String?
  shippingStreet     String?
  shippingHouseNo    String?
  shippingCity       String?
  shippingZip        String?
  deliveryMethod     String? // עזרה ורפואה | ניתאי | יוסי
  notes              String?
  /** האם לאסוף כתובת ומיקוד בטופס המשתתפים הציבורי */
  collectCertificateShipping Boolean @default(false)

  // Calendar
  googleCalendarEventId String?
  conflictBypassed      Boolean @default(false)

  /** ביקורת משתמשים — לינוי / יצחק */
  createdBy      String?
  lastUpdatedBy  String?
  /** מי סגר את העסקה (סטטוס נסגר) */
  closedBy       String?
  /** שיוך אופציונלי */
  assignedTo     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants  Participant[]
  trainingSessions TrainingSession[]
  expenses      Expense[]
  tasks         FollowUpTask[]
  trainingSales TrainingSale[]
  activityLogs  ActivityLog[]

  @@index([phone])
  @@index([courseStatus])
  @@index([urgency])
  @@index([scheduledStart])
  @@index([instructorId])
}

/** מפגש הדרכה בודד (תאריך/שעה/זום/כתובת) */
model TrainingSession {
  id          String  @id @default(cuid())
  leadId      String
  lead        Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  date        String  // YYYY-MM-DD
  startTime   String  // HH:mm
  endTime     String?
  isZoom      Boolean @default(false)
  /** קישור פגישת זום (אופציונלי) */
  zoomLink    String?
  city        String?
  street      String?
  houseNumber String?

  @@index([leadId])
  @@index([date])
}

/** יומן שינויי סטטוס / פעולות על ליד */
model ActivityLog {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performedBy    String
  previousStatus String?
  newStatus      String
  createdAt      DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

/** פרופיל מדריך — תעריף חי כמקור אמת לחישוב רווח */
model Instructor {
  id                        String         @id @default(cuid())
  name                      String         @unique
  fee                       Float          @default(0)
  phone                     String?
  username                  String?        @unique
  password                  String?
  salesCommissionPercentage Float          @default(0)
  role                      String         @default("INSTRUCTOR")
  active                    Boolean        @default(true)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  leads                     Lead[]
  reportedSales             TrainingSale[] @relation("ReportedByInstructor")

  @@index([username])
}

model Participant {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  traineeId       String?
  trainee         Trainee? @relation(fields: [traineeId], references: [id], onDelete: SetNull)
  fullName        String
  idNumber        String
  organizerName   String?
  courseDate      String?  // YYYY-MM-DD
  email           String?
  phone           String?
  satisfaction    String?
  feedback        String?
  kitInterest     String?
  shippingCity    String?
  shippingStreet  String?
  shippingHouseNo String?
  shippingZip     String?
  /** אישור הגעה / הקראת שמות */
  attended        Boolean  @default(false)
  /** נוצר משתמש LMS למודרך */
  hasLmsAccess    Boolean  @default(false)
  /** יוצא ל-Google Sheets (מניעת כפילויות) */
  sheetsExportedAt DateTime?
  /** קישור PDF לתעודה מ-Google Drive (עמודה N בגיליון) */
  certificateUrl  String?
  /** משתתף חיצוני / מצטרף נוסף */
  isExternal      Boolean  @default(false)
  /** מסומן כליד/אופציה — לא נספר בסכום הפעיל של ההדרכה */
  isLead          Boolean  @default(false)
  /** סוג קורס אישי לתעודה (חיצוני) */
  courseType      String?
  /** קטגוריה אישית לתעודה (חיצוני) */
  courseCategory  String?
  /** מחיר לתשלום אישי */
  agreedPrice     Float?
  paymentStatus   String?
  paymentDate     DateTime?
  paymentMethod   String?
  paymentReceivedBy String?
  paymentReceiptIssued Boolean @default(false)
  /** מקור הרשמה: manual | Wix */
  source          String   @default("manual")
  createdAt       DateTime @default(now())
  trainingSales   TrainingSale[]

  @@index([leadId])
  @@index([traineeId])
}

/** מאגר מודרכים גלובלי — נוצר אוטומטית מהרשמת משתתפים */
model Trainee {
  id                     String        @id @default(cuid())
  fullName               String
  idNumber               String
  phone                  String?
  email                  String?
  certificateEmailSent   Boolean       @default(false)
  certificateCardPrinted Boolean       @default(false)
  /** קישור PDF לתעודה (למודרכים שיוצאו ללא שיוך להדרכה) */
  certificateUrl         String?
  notes                  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  participants           Participant[]

  @@unique([idNumber])
  @@index([fullName])
  @@index([phone])
}

/** פריטי מלאי / ציוד למכירה */
model InventoryItem {
  id             String               @id @default(cuid())
  name           String
  category       String?
  sellingPrice   Float                @default(0)
  costPrice      Float                @default(0)
  supplierName   String?
  /** כמות שהוכנסה למלאי (רכישה) */
  totalPurchased Float                @default(0)
  /** יחידות שנמכרו ישירות או כחלק מתיקים */
  totalSold      Float                @default(0)
  isComposite    Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  components     InventoryComponent[] @relation("ParentItem")
  usedIn         InventoryComponent[] @relation("ChildItem")
  sales          TrainingSale[]

  @@index([category])
  @@index([name])
}

model InventoryComponent {
  id       String        @id @default(cuid())
  parentId String
  parent   InventoryItem @relation("ParentItem", fields: [parentId], references: [id], onDelete: Cascade)
  childId  String
  child    InventoryItem @relation("ChildItem", fields: [childId], references: [id], onDelete: Restrict)
  quantity Float         @default(1)

  @@unique([parentId, childId])
  @@index([childId])
}

/** מכירת ציוד בשטח להדרכה או מכירה עצמאית */
model TrainingSale {
  id                         String        @id @default(cuid())
  leadId                     String?
  lead                       Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  inventoryItemId            String
  inventoryItem              InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity                   Int           @default(1)
  unitSellingPrice           Float
  unitCostPrice              Float
  /// bit | bank_transfer | cash | paybox | check | other — null כשלא שולם
  paymentMethod              String?
  /// paid | PENDING_PAYMENT
  paymentStatus              String        @default("paid")
  participantId              String?
  participant                Participant?  @relation(fields: [participantId], references: [id], onDelete: SetNull)
  receiptIssued              Boolean       @default(false)
  reportedByInstructorId     String?
  reportedByInstructor       Instructor?   @relation("ReportedByInstructor", fields: [reportedByInstructorId], references: [id], onDelete: SetNull)
  instructorCommissionAmount Float         @default(0)
  isInstructorReported       Boolean       @default(false)
  createdAt                  DateTime      @default(now())

  @@index([leadId])
  @@index([inventoryItemId])
  @@index([participantId])
  @@index([reportedByInstructorId])
}

model Expense {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String   // instructor_fee | fuel_travel | disposables_supplies | venue_refreshments | other
  amount      Float
  notes       String?
  receiptPath String?
  createdAt   DateTime @default(now())

  @@index([leadId])
}

model FollowUpTask {
  id          String    @id @default(cuid())
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime? // null = משימה פתוחה ללא תאריך
  assignee    String?
  notes       String?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([dueDate])
}

model CourseAsset {
  id               String  @id @default(cuid())
  courseType       String  @unique
  title            String  @default("")
  hours            Int     @default(0)
  audience         String?
  durationText     String?
  natureText       String?
  contents         String?
  pricingText      String?
  summaryTemplate  String?
  bookletUrl       String?
  presentationUrl  String?
  presentationFile String?
  syllabusUrl      String?
  summaryText      String?
}

model Settings {
  id            String @id @default("default")
  businessName  String @default("עזרה ורפואה")
  websiteUrl    String?
  googleReviewUrl String?
  tiktokUrl     String?
  facebookUrl   String?
  instagramUrl  String?
  lmsApiUrl     String?
  lmsLoginUrl   String?
  calendarEnabled Boolean @default(false)
}

/** לידים לשיווק / יצירת קשר (נפרד מלידי הדרכה) */
model OutreachLead {
  id           String   @id @default(cuid())
  name         String
  phone        String
  organization String?
  category     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([phone])
  @@index([createdAt])
}

/** תבנית הודעת וואטסאפ לפי קטגוריה — קטגוריה אחת לתבנית אחת */
model OutreachMessageTemplate {
  id           String   @id @default(cuid())
  category     String   @unique
  templateText String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
